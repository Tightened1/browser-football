# Used by `npm run build:e2e` (vite build --mode e2e): the build the Playwright tests run against. Tests only.
# Signalling goes to the local PeerJS server started by playwright.config.ts (scripts/peerServer.mjs), not the public broker.
VITE_PEER_HOST=localhost
VITE_PEER_PORT=9000
VITE_PEER_PATH=/
VITE_PEER_SECURE=0
# Exposes window.__game so the tests can read the match state.
VITE_E2E=1
# No STUN servers: both pages are on this machine, so host candidates are enough and nothing waits for the internet.
VITE_STUN_URLS=
