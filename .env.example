# Copy to .env.local (git-ignored) and fill in ONE of the options. See docs/NETWORK_TESTING.md.
# For the live site, add the same names as GitHub repository secrets instead.

# Option A (recommended): a URL that returns ICE servers as JSON.
#   Metered:    https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<credential API key>
#   Cloudflare: the URL of your own Worker that calls Cloudflare's generate-ice-servers
VITE_TURN_CREDENTIALS_URL=

# Option B: fixed TURN credentials (comma-separated URLs).
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
